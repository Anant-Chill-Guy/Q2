{
  "info": {
    "name": "OOPJ MSE2 - Library CRUD API",
    "description": "Run Q2 Spring Boot project on localhost:8080 first",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 POST Create book (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Java Basics\",\n  \"author\": \"A. Kumar\",\n  \"category\": \"Programming\",\n  \"availableCopies\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2 GET All books (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "3 GET Book by ID (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        }
      }
    },
    {
      "name": "4 PUT Update book (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Advanced Java\",\n  \"author\": \"A. Kumar\",\n  \"category\": \"Programming\",\n  \"availableCopies\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5 DELETE Book (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        }
      }
    },
    {
      "name": "6 GET Missing book (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "1"
          ]
        }
      }
    }
  ]
}
